# Add these values to the environment used by the Frappe web and worker services.
FRAPPE_SENTRY_DSN=https://public-key@your-sentry-host/project-id
SENTRY_TRACING_SAMPLE_RATE=0.10
# Database monitoring is deliberately off because query parameters can contain
# tenant or customer data. Enable only after a privacy review.
ENABLE_SENTRY_DB_MONITORING=0
